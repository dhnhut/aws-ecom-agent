# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# `agentcore create` thinks it should be committed, but we don't want to commit it because it contains account information and other sensitive data
# # Exception: Commit the State
# !.cli/deployed-state.json

# This file is also generated by the CLI, but it contains account information and should not be committed also
aws-targets.json