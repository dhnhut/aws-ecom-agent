{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Ecom",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Ecom"
  },
  "runtimes": [
    {
      "name": "EcomCS",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EcomCS/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "connections": [
        {
          "to": { "type": "codeInterpreter" },
          "description": "Sandbox for calculate_loyalty_discount arithmetic"
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "EcomCSMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [
    {
      "type": "AgentCoreKnowledgeBase",
      "name": "CustomerSupportKB",
      "description": "Product catalog and customer-support reference for the Ecom store: product specs and pricing, warranty terms, return and refund policy, shipping options and troubleshooting steps.",
      "dataSources": [
        {
          "type": "S3",
          "uri": "s3://ecom-agent-extended-knowledge-base-566068566473-us-east-1"
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CustomerSupportGateway",
      "protocolType": "MCP",
      "description": "MCP gateway exposing customer support tools to the EcomCS agent",
      "targets": [
        {
          "name": "order-tracker",
          "targetType": "apiGateway",
          "apiGateway": {
            "restApiId": "z5dy835m83",
            "stage": "prod",
            "apiGatewayToolConfiguration": {
              "toolFilters": [
                {
                  "filterPath": "/*",
                  "methods": [
                    "GET"
                  ]
                }
              ]
            }
          }
        },
        {
          "name": "refund-processor",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "initiate_refund",
              "description": "Initiate a refund for a customer order.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Reason for refund"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Refund amount in USD"
                  },
                  "order_id": {
                    "type": "string",
                    "description": "Order ID to refund"
                  }
                },
                "required": [
                  "order_id",
                  "reason"
                ]
              }
            },
            {
              "name": "check_refund_status",
              "description": "Check the status of an existing refund.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "refund_id": {
                    "type": "string",
                    "description": "Refund ID to check"
                  }
                },
                "required": [
                  "refund_id"
                ]
              }
            },
            {
              "name": "get_return_label",
              "description": "Generate a prepaid return shipping label for an order.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "description": "Order ID needing a label"
                  }
                },
                "required": [
                  "order_id"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "lambda/refund_processor/",
              "handler": "refund_processor.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 30,
            "memorySize": 512
          },
          "outboundAuth": {
            "type": "NONE"
          }
        },
        {
          "name": "customer-support-kb",
          "targetType": "connector",
          "connectorId": "bedrock-knowledge-bases",
          "configurations": [
            {
              "name": "AgenticRetrieveStream",
              "description": "Streaming endpoint for agentic retrieval from knowledge bases. Performs multi-step retrieval with planning and returns results as a stream of events.",
              "parameterValues": {
                "retrievers": [
                  {
                    "configuration": {
                      "knowledgeBase": {
                        "knowledgeBaseId": "CustomerSupportKB"
                      }
                    }
                  }
                ],
                "agenticRetrieveConfiguration": {
                  "foundationModelType": "MANAGED",
                  "rerankingModelType": "MANAGED"
                }
              },
              "parameterOverrides": []
            },
            {
              "name": "Retrieve",
              "description": "Queries a knowledge base and retrieves information from it.",
              "parameterValues": {
                "knowledgeBaseId": "CustomerSupportKB"
              },
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
