{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Ecom",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Ecom"
  },
  "runtimes": [
    {
      "name": "EcomCS",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EcomCS/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "EcomCSMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "EcomCS-gateway",
      "protocolType": "MCP",
      "description": "Gateway for EcomCS-gateway",
      "targets": [
        {
          "name": "order-tracker",
          "targetType": "apiGateway",
          "apiGateway": {
            "restApiId": "k2x5vrfn68",
            "stage": "prod",
            "apiGatewayToolConfiguration": {
              "toolFilters": [
                {
                  "filterPath": "/orders/{order_id}",
                  "methods": [
                    "GET"
                  ]
                },
                {
                  "filterPath": "/customers/{customer_id}",
                  "methods": [
                    "GET"
                  ]
                },
                {
                  "filterPath": "/customers/{customer_id}/orders",
                  "methods": [
                    "GET"
                  ]
                }
              ],
              "toolOverrides": [
                {
                  "path": "/orders/{order_id}",
                  "method": "GET",
                  "name": "getOrderById",
                  "description": "Look up a single order by its order ID, including status, items, total, carrier and tracking number."
                },
                {
                  "path": "/customers/{customer_id}",
                  "method": "GET",
                  "name": "getCustomer",
                  "description": "Get a customer profile: name, loyalty points and membership tier."
                },
                {
                  "path": "/customers/{customer_id}/orders",
                  "method": "GET",
                  "name": "listCustomerOrders",
                  "description": "List every order belonging to a customer."
                }
              ]
            }
          }
        },
        {
          "name": "refund-processor",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:566068566473:function:refund-processor",
            "toolSchemaFile": "lambda/refund_processor/lambda_schema.json"
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}