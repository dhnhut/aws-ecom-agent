{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Ecom",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Ecom"
  },
  "runtimes": [
    {
      "name": "EcomCS",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EcomCS/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "EcomCSMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CustomerSupportGateway",
      "protocolType": "MCP",
      "description": "MCP gateway exposing customer support tools to the EcomCS agent",
      "targets": [
        {
          "name": "order-tracker",
          "targetType": "apiGateway",
          "apiGateway": {
            "restApiId": "z5dy835m83",
            "stage": "prod",
            "apiGatewayToolConfiguration": {
              "toolFilters": [
                {
                  "filterPath": "/*",
                  "methods": [
                    "GET"
                  ]
                }
              ]
            }
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}